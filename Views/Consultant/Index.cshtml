@model ConsultantViewModel

<!-- Custom CSS -->
<style>
    .summary-section, .actions-section, .users-section {
        margin-bottom: 30px;
    }

        .summary-section h3, .actions-section h3, .users-section h3 {
            color: #007bff;
        }

        .actions-section ul {
            list-style-type: none;
            padding-left: 0;
        }

            .actions-section ul li {
                margin-bottom: 10px;
            }

                .actions-section ul li a {
                    text-decoration: none;
                    color: #007bff;
                }

                    .actions-section ul li a:hover {
                        color: #0056b3;
                    }
</style>



<!-- Summary Section -->
<div class="summary-section">

    <div class="row">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Users</h5>
                    <p class="card-text">@Model.TotalUsers</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Transactions</h5>
                    <p class="card-text">@Model.TotalTransactions</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Bank Accounts</h5>
                    <p class="card-text">@Model.TotalBankAccounts</p>
                </div>
            </div>
        </div>
    </div>
</div>

<hr />

<!-- Actions Section -->
<div class="actions-section mt-4">
    <h3><i class="fas fa-cogs"></i> Actions</h3>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th scope="col"><i class="fas fa-tasks"></i> Action</th>
                <th scope="col"><i class="fas fa-info-circle"></i> Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <a asp-controller="Consultant" asp-action="ViewAllLogins">
                        <i class="fas fa-sign-in-alt"></i> View All User Logins
                    </a>
                </td>
                <td>View the logins of all users in the system.</td>
            </tr>
           
            <tr>
                <td>
                    <a asp-controller="Consultant" asp-action="TransferFundsBetweenUsers">
                        <i class="fas fa-exchange-alt"></i> Transfer Funds Between Users
                    </a>
                </td>
                <td>Facilitate fund transfers between different user accounts.</td>
            </tr>
            <tr>
                <td>
                    <a asp-controller="Consultant" asp-action="GenerateReport">
                        <i class="fas fa-file-alt"></i> Generate System Report
                    </a>
                </td>
                <td>Generate detailed reports of the system activities.</td>
            </tr>
        </tbody>
    </table>
</div>


<hr />

<!-- User Management Section -->
<div class="users-section">
    <h3><i class="fas fa-users-cog"></i> User Management</h3>
    <table class="table table-striped">
        <thead class="thead-dark">
            <tr>
                <th>Email</th>
                <th>View Transactions</th>
                <th>Deposi /Withdraw</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.appUsers)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>
                        <a asp-controller="Consultant" asp-action="ViewUserTransactions" asp-route-email="@user.Email">
                            <i class="fas fa-eye"></i> View Transactions
                        </a> 
                        </td>
                        <td>
                        <a asp-controller="Consultant" asp-action="DepositWithdraw" asp-route-email="@user.Email">
                            <i class="fas fa-edit"></i> Deposi /Withdraw
                        </a>
                        </td>
                       <td>
                        <a asp-controller="Consultant" asp-action="ConsultantDeleteUser" asp-route-email="@user.Email" onclick="return confirmDelete();">
                            <i class="fas fa-trash-alt"></i> Delete
                        </a> 
                        
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Message Alert Section -->
@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <div class="alert alert-info mt-3">
        <i class="fas fa-info-circle"></i> @ViewBag.Message
    </div>
}

<!-- Custom JavaScript -->
<script>
    function confirmDelete() {
        return confirm('Are you sure you want to delete this user?');
    }
</script>
