@model CconsultantViewModel

<div class="container mt-5">
    <h2><i class="fas fa-user-clock"></i> User Login Sessions</h2>

    @if (Model.LoginSessions != null && Model.LoginSessions.Any())
    {
        <table class="table table-striped table-hover mt-3">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col"><i class="fas fa-envelope"></i> User Email</th>
                    <th scope="col"><i class="fas fa-calendar-alt"></i> Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Model.LoginSessions)
                {
                    <tr>
                        <td>@session.Id</td>
                        <td>@session.UserEmail</td>
                        <td>@session.TimeStamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> No login sessions available.
        </div>
    }
</div>

