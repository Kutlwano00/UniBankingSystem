@model ConsultantDepositModel

<div class="container mt-5">
    <h2><i class="fas fa-money-check-alt"></i> Deposit/Withdraw Funds</h2>
    <hr />

    <!-- Display any messages -->
    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> @ViewBag.Message
        </div>
    }

    <!-- Display errors -->
    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i> There were some errors with your submission:
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <!-- Form to deposit/withdraw funds -->
    <form asp-action="DepositWithdraw" method="post" class="needs-validation" novalidate>
        <div class="form-group">
            <label for="accountNumber"><i class="fas fa-university"></i> Account Number</label>
            <input type="text" class="form-control" id="accountNumber" value="@Model.AccountNumber" readonly />
        </div>

        <div class="form-group">
            <label for="userEmail"><i class="fas fa-envelope"></i> User Email</label>
            <input type="email" class="form-control" id="userEmail" value="@Model.UserEmail" readonly />
        </div>

        <div class="form-group">
            <label for="amount"><i class="fas fa-dollar-sign"></i> Amount</label>
            <input type="number" class="form-control" id="amount" name="Amount" step="0.01" min="0" required />
            <div class="invalid-feedback">
                Please enter a valid amount.
            </div>
        </div>

        <div class="form-group">
            <label for="actionType"><i class="fas fa-hand-holding-usd"></i> Action</label>
            <div class="btn-group" role="group" aria-label="Deposit or Withdraw">
                <button type="submit" name="action" value="deposit" class="btn btn-success">
                    <i class="fas fa-arrow-up"></i> Deposit
                </button>
                <button type="submit" name="action" value="withdraw" class="btn btn-danger">
                    <i class="fas fa-arrow-down"></i> Withdraw
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Include client-side validation script -->
<script>
    (function () {
        'use strict';
        window.addEventListener('load', function () {
            var forms = document.getElementsByClassName('needs-validation');
            Array.prototype.filter.call(forms, function (form) {
                form.addEventListener('submit', function (event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();
</script>
