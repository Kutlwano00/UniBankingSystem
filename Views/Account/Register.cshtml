@model RegisterViewModel
@{
    ViewBag.Title = "Register";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="row card shadow-lg p-4">
        <!-- Left Side: Title and Switch between Student/Staff -->
        <div class="col-md-12 bg-light p-4 d-flex flex-column justify-content-center">
            <h2 class="display-6 text-primary text-center mb-4">
                <i class="fas fa-user-plus"></i> Welcome, create your account
            </h2>

            <div class="btn-group text-center">
                <a asp-controller="Account" asp-action="Register" asp-route-registerAs="student"
                   class="btn btn-success btn-lg w-50 @(Model.RegisterAs == "student" ? "active" : "")">
                    <i class="fas fa-graduation-cap"></i> Student
                </a>

                <a asp-controller="Account" asp-action="Register" asp-route-registerAs="staff"
                   class="btn btn-info btn-lg w-50 @(Model.RegisterAs == "staff" ? "active" : "")">
                    <i class="fas fa-briefcase"></i> Staff
                </a>
            </div>

            <div class="text-danger mt-3" asp-validation-summary="All"></div>
        </div>

        <!-- Right Side: Form Fields -->
        <div class="col-md-12 bg-white p-4">
            <form asp-action="Register" asp-controller="Account" method="post">
                <input type="hidden" asp-for="RegisterAs" />

                <div class="row">
                    <!-- Left Column -->
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="text-uppercase fw-bold text-dark" asp-for="EmailAddress">
                                <i class="fas fa-envelope"></i> Email Address
                            </label>
                            <small class="text-muted">Email must be unique</small>
                            <input class="form-control" asp-for="EmailAddress" autocomplete="off" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-uppercase fw-bold text-dark" asp-for="StudentStaffNumber">
                                <i class="fas fa-user-tag"></i> Student/Staff Number
                            </label>
                            <input class="form-control" asp-for="StudentStaffNumber" autocomplete="off" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-uppercase fw-bold text-dark" asp-for="FirstName">
                                <i class="fas fa-user"></i> First Name
                            </label>
                            <input class="form-control" asp-for="FirstName" autocomplete="off" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-uppercase fw-bold text-dark" asp-for="Password">
                                <i class="fas fa-lock"></i> Password
                            </label>
                            <input class="form-control" asp-for="Password" autocomplete="off" />
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="text-uppercase fw-bold text-dark" asp-for="IdPassportNumber">
                                <i class="fas fa-id-card"></i> ID/Passport Number
                            </label>
                            <input class="form-control" asp-for="IdPassportNumber" autocomplete="off" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-uppercase fw-bold text-dark" asp-for="LastName">
                                <i class="fas fa-user"></i> Last Name
                            </label>
                            <input class="form-control" asp-for="LastName" autocomplete="off" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-uppercase fw-bold text-dark" asp-for="ConfirmPassword">
                                <i class="fas fa-lock"></i> Confirm Password
                            </label>
                            <input class="form-control" asp-for="ConfirmPassword" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-dark btn-sm shadow-sm">
                        <i class="fas fa-user-plus"></i> Sign up
                    </button>
                    <br /><br />
                    Already registered?
                    <a asp-action="Login" asp-controller="Account" class="text-primary">
                        Log in
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
