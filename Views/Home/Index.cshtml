@page

<!-- Add Bootstrap and Font Awesome styles -->
<link href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<!-- Custom Styles -->
<style>
    body {
        background-color: blue;
    }

    .hero {
        background-color: darkblue;
    }

    .card {
        background-color: white;
    }

    .card-title {
        color: darkblue;
    }

    .btn-custom {
        background-color: red;
        color: white;
        border: none;
    }

        .btn-custom:hover {
            background-color: darkred;
        }
</style>

<div class="container-fluid">
    <!-- Hero Section -->
    <header class="hero text-white text-center py-5">
        <div class="container">
            <h1 class="display-4">Online Banking System</h1>
            <p class="lead">Your ultimate destination for comprehensive solutions</p>
        </div>
    </header>

    <!-- Features Section -->
    <section id="features" class="py-5">
        <div class="container">
            <h2 class="text-center mb-4 text-white">Why We Stand Out</h2>
            <div class="row text-center">
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Dependable</h5>
                            <p class="card-text">Count on us for dependable service every time.</p>
                            <a href="#" class="btn btn-custom mt-3">Learn More</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Cost-Effective</h5>
                            <p class="card-text">Our services are designed to be budget-friendly.</p>
                            <a href="#" class="btn btn-custom mt-3">Learn More</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Expertise</h5>
                            <p class="card-text">Our team is skilled and professional across all areas.</p>
                            <a href="#" class="btn btn-custom mt-3">Learn More</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call-to-Action Section -->
    <section id="cta" class="text-center py-5">
        <div class="container">
            <a href="#" class="btn btn-custom btn-lg">Get Started Today</a>
        </div>
    </section>
</div>

<!-- Add Bootstrap and Font Awesome JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
